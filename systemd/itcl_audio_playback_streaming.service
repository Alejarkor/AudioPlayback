[Unit]
Description=ITCL Audio Playback Streaming
Wants=network-online.target
After=network-online.target sound.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nexor
Group=nexor
SupplementaryGroups=audio
WorkingDirectory=/opt/nexor/audio-playback
ExecStart=/opt/nexor/audio-playback/venv/bin/python -m audio_playback_service.main --config /etc/nexor/audio-playback.json --log-level INFO
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/nexor/mqtt.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=itcl-audio-playback-streaming
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
Alias=audio-playback.service audio_playback.service
